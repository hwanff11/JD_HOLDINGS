# Runtime: dry_run 또는 live
JDSS_TRADING_MODE=dry_run
# live 주문에는 아래 문구가 정확히 일치해야 합니다.
JDSS_LIVE_CONFIRMATION=

# Toss Securities
TOSS_APP_KEY=
TOSS_APP_SECRET=
TOSS_ACCOUNT_SEQ=1

# Telegram: 쉼표로 구분할 수 있으나 기본은 관리자 1명만 사용합니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=

# Paths
JDSS_DB_PATH=data/jdss.db
JDSS_LOG_PATH=logs/jdss.log

# Deployment (deploy.sh)
SSH_KEY_PATH=
SERVER_HOST=
SERVER_USER=ubuntu
SERVER_TARGET_DIR=/home/ubuntu/jd_holdings
SYSTEMD_SERVICE=jd_holdings_bot
REMOTE_PYTHON_BIN=python3.12
