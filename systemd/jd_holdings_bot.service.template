[Unit]
Description=JD Holdings JDSS Telegram Trading Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVER_USER__
Group=__SERVER_USER__
WorkingDirectory=__TARGET_DIR__/current
EnvironmentFile=__TARGET_DIR__/shared/.env
Environment=PYTHONUNBUFFERED=1
Environment=JDSS_DB_PATH=__TARGET_DIR__/shared/data/jdss.db
Environment=JDSS_LOG_PATH=__TARGET_DIR__/shared/logs/jdss.log
ExecStart=__TARGET_DIR__/venv/bin/jdss-bot
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__TARGET_DIR__/shared

[Install]
WantedBy=multi-user.target
